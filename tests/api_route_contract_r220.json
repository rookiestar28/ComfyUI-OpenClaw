    "health_handler": {
      "audit": "health.check",
      "auth": "public",
      "description": "Returns pack status, uptime, dependencies, and stats.",
      "plane": "user",
      "risk": "low",
      "scopes": [],
      "summary": "Health check"
    },
    "jobs_handler": {
      "audit": "jobs.list",
      "auth": "admin",
      "description": "Admin-authorized versioned bounded in-process jobs read model.",
      "plane": "admin",
      "risk": "low",
      "scopes": [],
      "summary": "List jobs"
    },
    "logs_tail_handler": {
      "audit": "logs.tail",
      "auth": "admin",
      "description": "Returns the last N lines of the log file.",
      "plane": "admin",
      "risk": "medium",
      "scopes": [],
      "summary": "Tail logs"
    },
    "trace_handler": {
      "audit": "trace.get",
      "auth": "admin",
      "description": "Returns redacted timeline for a prompt.",
      "plane": "admin",
      "risk": "medium",
      "scopes": [],
      "summary": "Get trace"
    }
  },
