{
  "name": "comfyui-openclaw",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "jsdom": "^26.0.0",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "test": "node scripts/run-playwright.mjs",
    "test:stress": "node scripts/run-playwright.mjs --stress",
    "test:unit": "node scripts/check-node-runtime.mjs && vitest run",
    "test:unit:watch": "node scripts/check-node-runtime.mjs && vitest",
    "test:ui": "node scripts/check-node-runtime.mjs && npx playwright test --ui",
    "test:headed": "node scripts/check-node-runtime.mjs && npx playwright test --headed",
    "test:debug": "node scripts/check-node-runtime.mjs && npx playwright test --debug",
    "test:report": "node scripts/check-node-runtime.mjs && npx playwright show-report"
  }
}
